<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0"/>
        <PackageReference Include="Confluent.Kafka" Version="2.15.0"/>
        <PackageReference Include="Dapper" Version="2.1.79"/>
        <PackageReference Include="dbup-sqlserver" Version="7.2.0"/>
        <PackageReference Include="FluentValidation" Version="12.1.1"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1"/>
        <PackageReference Include="Hangfire" Version="1.8.25"/>
        <PackageReference Include="MediatR" Version="14.2.0"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10"/>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2"/>
        <PackageReference Include="Microsoft.OpenApi" Version="2.9.0"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="Polly" Version="8.7.0"/>
        <PackageReference Include="protobuf-net" Version="3.4.14"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Contracts\TradingSystem.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Infrastructure\Persistence\Migrations\*.sql"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Presentation\gRpc\"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

</Project>
