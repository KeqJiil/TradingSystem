{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5026"
      },
      "Grpc": {
        "Url": "http://localhost:5027"
      }
    }
  },
  "KafkaOptions": {
    "BootstrapServers": "localhost:9092",
    "ProducerClientId": "order-producer"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5026",
          "https://localhost:7262"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}